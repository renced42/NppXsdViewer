    <ProjectReference Include="..\NppXsdViewer.Diagram\NppXsdViewer.Diagram.csproj">
      <Project>{C7984D1B-8F62-46C0-91D2-B9B2C1442D20}</Project>
      <Name>NppXsdViewer.Diagram</Name>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
