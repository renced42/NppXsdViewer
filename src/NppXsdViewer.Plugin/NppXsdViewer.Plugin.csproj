    <ItemGroup>
      <PluginDistributionFiles Include="$(TargetPath)" />
      <PluginDistributionFiles Include="$(TargetDir)NppXsdViewer.Schema.dll" />
      <PluginDistributionFiles Include="$(TargetDir)NppXsdViewer.Diagram.dll" />
    </ItemGroup>

    <RemoveDir Directories="$(PluginDistributionDir)" Condition="Exists('$(PluginDistributionDir)')" />
    <MakeDir Directories="$(PluginDistributionDir)" />
    <Copy SourceFiles="@(PluginDistributionFiles)" DestinationFolder="$(PluginDistributionDir)" SkipUnchangedFiles="true" />

    <Message Importance="high" Text="Notepad++ plugin distribution: $(PluginDistributionDir)" />
  </Target>
</Project>
